# Copy this file to .env and fill values locally.
# Never commit real API keys or licensed source data.

# Authorized 5e.tools Chinese data root.
FIVEETOOLS_DATA_DIR=/absolute/path/to/fvtt-cn/5etools/data

# DeepSeek answer generation.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Alibaba Cloud Model Studio / DashScope embedding.
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
